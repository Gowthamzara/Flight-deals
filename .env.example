# Copy this file to .env and fill in your own values. Never commit .env!

# Sheety (spreadsheet API)
SHEETY_USERNAME=
SHEETY_PASSWORD=
SHEETY_PRICES_ENDPOINT=https://api.sheety.co/<your_id>/<your_project>/prices

# SerpAPI (Google Flights)
SERPAPI_API_KEY=

# Email alerts (Gmail: create an App Password, not your normal password)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# ALERT_TO_EMAIL=someone_else@example.com   # optional, defaults to EMAIL_ADDRESS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Optional trip settings
# ORIGIN_CITY_IATA=LHR
# DAYS_UNTIL_DEPARTURE=30
# TRIP_LENGTH_DAYS=14
